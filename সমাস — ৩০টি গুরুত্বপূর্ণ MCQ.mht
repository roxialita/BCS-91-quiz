@charset "utf-8";

* { box-sizing: border-box; }

body { font-family: "Noto Sans Bengali", "Noto Sans", Arial, sans-serif; background: rgb(244, 246, 248); color: rgb(32, 33, 36); margin: 0px; padding: 16px; }

.container { max-width: 800px; margin: auto; background: rgb(255, 255, 255); padding: 20px; border-radius: 14px; box-shadow: rgba(0, 0, 0, 0.067) 0px 2px 12px; }

h1 { font-size: 25px; margin: 0px 0px 6px; text-align: center; }

.subtitle { text-align: center; color: rgb(102, 102, 102); font-size: 14px; margin-bottom: 16px; }

.name { margin-bottom: 18px; }

.name label { font-weight: 700; display: block; margin-bottom: 6px; }

input[type="text"] { width: 100%; padding: 11px; border: 1px solid rgb(204, 204, 204); border-radius: 8px; font-size: 16px; }

.q { border: 1px solid rgb(221, 221, 221); border-radius: 10px; padding: 13px; margin: 10px 0px; background: rgb(255, 255, 255); }

.qt { font-weight: 700; line-height: 1.55; margin-bottom: 7px; }

.option { display: block; padding: 8px 6px; border-radius: 7px; cursor: pointer; line-height: 1.5; }

.option:hover { background: rgb(241, 243, 244); }

.option input { margin-right: 7px; }

button { width: 100%; padding: 13px; border: 0px; border-radius: 9px; background: rgb(34, 34, 34); color: rgb(255, 255, 255); font-size: 17px; font-weight: 700; cursor: pointer; margin-top: 15px; }

.result { margin-top: 18px; padding: 15px; border-radius: 10px; background: rgb(247, 247, 247); border: 1px solid rgb(221, 221, 221); }

.wrong { margin-top: 10px; padding: 10px; border-left: 4px solid rgb(221, 51, 51); background: rgb(255, 255, 255); }

.correct { margin-top: 10px; padding: 10px; border-left: 4px solid rgb(41, 148, 74); background: rgb(255, 255, 255); }

hr { border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(221, 221, 221) currentcolor currentcolor; border-image: none; margin: 14px 0px; }

@media (max-width: 480px) {
  body { padding: 8px; }
  .container { padding: 12px; }
  h1 { font-size: 21px; }
  .q { padding: 11px; }
}
